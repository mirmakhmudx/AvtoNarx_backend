 .../Parser/Adapters/OlxUzAdapter.php         | 11 +++-
 .../Extraction/AccessoryListingDetector.php  | 78 +++++++++++++++++++
 .../AccessoryListingDetectorTest.php         | 31 ++++++++
 4 files changed, 130 insertions(+), 2 deletions(-)
 create mode 100644 app/Services/Parser/Extraction/AccessoryListingDetector.php
 create mode 100644 tests/Unit/Parser/Extraction/AccessoryListingDetectorTest.php

