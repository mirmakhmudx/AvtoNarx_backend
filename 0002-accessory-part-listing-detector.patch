diff --git a/app/Services/Parser/Extraction/AccessoryListingDetector.php b/app/Services/Parser/Extraction/AccessoryListingDetector.php
new file mode 100644
index 0000000..84214bd
--- /dev/null
+++ b/app/Services/Parser/Extraction/AccessoryListingDetector.php
@@ -0,0 +1,78 @@
+<?php
+
+namespace App\Services\Parser\Extraction;
+
+/**
+ * OLX'ning "Transport / Yengil avtomobillar" (legkovye-avtomobili) kategoriyasi
+ * targetlar uchun to'g'ri tanlangan bo'lsa-da (ParserTarget::target_url shu
+ * kategoriyaga qattiq bog'langan), ayrim sotuvchilar ehtiyot qism yoki
+ * aksessuarlarni (dvigatel, bamper, forma va h.k.) xato ravishda shu
+ * kategoriyada joylashtiradi. Bunday kartochka sarlavhasida model nomi
+ * bo'lishi mumkin (masalan "Chevrolet Cobalt dvigatel sotiladi"), shuning
+ * uchun TitleModelMatcher buni ushlamaydi — bu haqiqiy mashina emasligini
+ * aniqlash uchun alohida, tor va aniq kalit so'zlar ro'yxati kerak.
+ *
+ * Ataylab TOR ro'yxat: umumiy so'zlar (masalan yolg'iz "disk") olinmagan,
+ * chunki noto'g'ri rad etish (haqiqiy mashina e'lonini yo'qotish) tor bo'lsa
+ * ham qimmatga tushadi. Faqat ehtiyot qism/butlovchi qism kontekstida deyarli
+ * har doim ishlatiladigan, mashina sotuv e'lonlarida deyarli uchramaydigan
+ * so'z birikmalari kiritilgan.
+ */
+class AccessoryListingDetector
+{
+    /**
+     * @var array<int, string> Kichik harfda, Rus (asosiy til OLX.uz'da) va
+     *      lotin transliteratsiyasi bilan.
+     */
+    private const KEYWORDS = array(
+        'запчаст',      // запчасти, запчасть, запчастей
+        'zapchast',
+        'на разбор',
+        'на запчаст',
+        'разборка',
+        'разбор двиг',
+        'двигатель от',
+        'двигатель на',
+        'акпп продажа',
+        'мкпп продажа',
+        'кузов от',
+        'кузов на',
+        'бампер от',
+        'бампер на',
+        'капот от',
+        'капот на',
+        'крыло от',
+        'крыло на',
+        'фара от',
+        'фара на',
+        'фары от',
+        'радиатор от',
+        'стартер от',
+        'генератор от',
+        'глушитель от',
+        'торпедо от',
+        'руль от',
+        'сиденья от',
+        'сидения от',
+        'коробка передач от',
+        'коробка передач на',
+        'ehtiyot qism',
+        'zapchastlar',
+    );
+
+    /**
+     * @return bool  true — sarlavha ehtiyot qism/aksessuar e'loniga o'xshaydi.
+     */
+    public function isAccessoryOrPartListing(string $titleText): bool
+    {
+        if (trim($titleText) === '') {
+            return false;
+        }
+
+        $normalized = mb_strtolower($titleText);
+
+        foreach (self::KEYWORDS as $keyword) {
+            if (str_contains($normalized, $keyword)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+}
diff --git a/tests/Unit/Parser/Extraction/AccessoryListingDetectorTest.php b/tests/Unit/Parser/Extraction/AccessoryListingDetectorTest.php
new file mode 100644
index 0000000..a1b2c3d
--- /dev/null
+++ b/tests/Unit/Parser/Extraction/AccessoryListingDetectorTest.php
@@ -0,0 +1,31 @@
+<?php
+
+use App\Services\Parser\Extraction\AccessoryListingDetector;
+
+beforeEach(function () {
+    $this->detector = new AccessoryListingDetector();
+});
+
+it('detects a spare-parts listing even though the model name is correct', function () {
+    expect($this->detector->isAccessoryOrPartListing('Chevrolet Cobalt zapchastlar, dvigatel na razbor'))
+        ->toBeTrue();
+});
+
+it('detects Russian "на запчасти" (parting out) listings', function () {
+    expect($this->detector->isAccessoryOrPartListing('Chevrolet Nexia на запчасти, кузов целый'))
+        ->toBeTrue();
+});
+
+it('detects "бампер от" (bumper from) style accessory listings', function () {
+    expect($this->detector->isAccessoryOrPartListing('Бампер от Cobalt 2, новый'))
+        ->toBeTrue();
+});
+
+it('does not flag a normal car sale listing', function () {
+    expect($this->detector->isAccessoryOrPartListing('Chevrolet Cobalt, 2019, otlichnoe sostoyanie, torg'))
+        ->toBeFalse();
+});
+
+it('does not flag a car listing that merely mentions original parts/service history', function () {
+    expect($this->detector->isAccessoryOrPartListing('Chevrolet Cobalt, 2020, original, texosmotr yangi'))
+        ->toBeFalse();
+});
+
+it('treats empty title as not an accessory listing (handled by other rules)', function () {
+    expect($this->detector->isAccessoryOrPartListing(''))->toBeFalse();
+});
